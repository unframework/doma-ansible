[Unit]
Description=Scan Google Tasks for shopping items and post an inbox event
After=network.target

[Service]
Type=oneshot
WorkingDirectory={{ ansible_env.HOME }}/.openclaw/workspace
ExecStart=/usr/bin/python3 {{ ansible_env.HOME }}/.openclaw/workspace/scripts/gtasks-shopping-post.py
Environment="PATH={{ ansible_env.HOME }}/.nvm/versions/node/v22.21.1/bin:/usr/local/bin:/usr/bin:/bin"

[Install]
WantedBy=default.target
