[Unit]
Description=Render Claude Code sessions into the archive repo and push
After=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash {{ ansible_env.HOME }}/.openclaw/workspace/scripts/claude-session-archive.sh {{ claude_session_archive_dir }}
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
TimeoutStartSec=10min

[Install]
WantedBy=default.target
