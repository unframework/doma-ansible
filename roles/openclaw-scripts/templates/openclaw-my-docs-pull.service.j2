[Unit]
Description=Fast-forward the my-docs editing clone onto the sync remote
After=network.target

[Service]
Type=oneshot
WorkingDirectory={{ ansible_env.HOME }}/.openclaw/workspace
ExecStart={{ ansible_env.HOME }}/.openclaw/workspace/scripts/my-docs-pull.sh {{ my_docs_clone_dir }}
# Reports today's calendar commits to the agent as an inbox event. Ordered
# ahead of the qmd line because that one has no `-` prefix, and a failing
# ExecStartPost makes systemd skip every later one. `-` here so a gateway
# outage can't mask this unit's own health signal, which is "did the clone
# refresh" — failures still show up in the journal.
ExecStartPost=-/usr/bin/python3 {{ ansible_env.HOME }}/.openclaw/workspace/scripts/gcal-watch.py --clone {{ my_docs_clone_dir }}
# The fast-forward refreshes the qmd source tree; reindex afterwards.
ExecStartPost=/bin/bash -c 'export PATH="{{ ansible_env.HOME }}/.nvm/versions/node/v22.21.1/bin:$PATH" && qmd update && qmd embed'
Environment="PATH={{ ansible_env.HOME }}/.nvm/versions/node/v22.21.1/bin:/usr/local/bin:/usr/bin:/bin"

[Install]
WantedBy=default.target
