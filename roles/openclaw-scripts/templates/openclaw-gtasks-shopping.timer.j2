[Unit]
Description=Scan for shopping tasks hourly, 10 min after the ledger fetch

[Timer]
# ledger-fetch-all runs at :00 and refreshes ~/ledger-data/gtasks/main.yaml,
# which is what the scan reads. Offset so we scan freshly-synced data.
OnCalendar=*:10
Persistent=true

[Install]
WantedBy=timers.target
