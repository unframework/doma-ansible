[Unit]
Description=Herd agent session server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory={{ herd_install_dir }}/server
ExecStart={{ ansible_env.HOME }}/.nvm/versions/node/{{ herd_node_version }}/bin/node {{ herd_install_dir }}/server/herd-server.cjs
Restart=on-failure
RestartSec=2
# Agent sessions run builds/tests inside this cgroup: cap it so a runaway child is OOM-killed on its own
# (OOMPolicy=continue) instead of exhausting host RAM+swap and taking the whole unit down with it.
OOMPolicy=continue
MemoryMax={{ herd_memory_max }}
MemorySwapMax={{ herd_memory_swap_max }}
Environment=HOME={{ ansible_env.HOME }}
Environment=TMPDIR=/tmp
Environment=PATH={{ herd_service_path }}
Environment=HERD_PORT={{ herd_port }}
Environment=HERD_HOST={{ herd_bind_host }}
Environment=HERD_UI_DIST={{ herd_install_dir }}/ui
Environment=HERD_CLAUDE_BIN={{ ansible_env.HOME }}/.local/bin/claude
{% if herd_portless_domain %}
Environment=HERD_PORTLESS_DOMAIN={{ herd_portless_domain }}
{% endif %}
{% if herd_voice_input %}
Environment=HERD_OPENAI_API_KEY={{ herd_openai_api_key }}
{% endif %}

[Install]
WantedBy=default.target
