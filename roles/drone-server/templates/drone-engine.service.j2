[Unit]
Description=drone-server engine (drone, rain, thunder, SuperDirt layers)
Wants=drone-watch.service

[Service]
Type=notify
NotifyAccess=all
WorkingDirectory={{ drone_server_dir }}
ExecStartPre={{ drone_server_dir }}/rain-prep.sh
ExecStart={{ drone_server_dir }}/engine.sh engine 57120 engine.scd
Environment=IDLE_EXIT={{ drone_server_idle_exit }}
TimeoutStartSec=60
Restart=on-failure
RestartSec=5
