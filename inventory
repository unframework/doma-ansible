[doma]
plankton.local ansible_user=mmatants ansible_connection=local
sandy.local    ansible_user=mmatants ansible_connection=ssh

# Which host currently runs the OpenClaw gateway (+ companions).
# During migration both hosts are members; sandy is exercised via role tags.
# At cutover, remove plankton.local and keep only sandy.local here.
[openclaw_host]
plankton.local
sandy.local

# Host running the workspace web Mini App. Must be the host holding
# ~/.openclaw/timeline and the bot token in ~/.openclaw/openclaw.json.
[webapp_host]
plankton.local

[doma:vars]
ansible_python_interpreter=/usr/bin/python3
