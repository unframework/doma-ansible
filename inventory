[doma]
plankton.local ansible_user=mmatants ansible_connection=local
sandy.local    ansible_user=mmatants ansible_connection=ssh

# Which host currently runs the OpenClaw gateway (+ companions). During migration
# both hosts are members; sandy is exercised via role tags. At cutover, remove
# plankton.local and keep only sandy.local here.
[openclaw_host]
plankton.local
# Added for pre-seed: sandy needs dev/openclaw-base/openclaw-scripts applied
# before cutover. Safe because host_vars/sandy.local.yml sets
# openclaw_scripts_active and openclaw_gateway_enabled to false, so membership
# templates the units without starting anything.
sandy.local

# Host running the workspace web Mini App. Must be the host holding
# ~/.openclaw/timeline and the bot token in ~/.openclaw/openclaw.json.
[webapp_host]
sandy.local

# Host running the herd agent session server (tailnet-only via Tailscale Serve).
# Deliberately BOTH hosts, running in parallel. Each node serves on its own
# tailnet name, so the :8443 mappings do not collide. herd is how agent
# sessions reach the box — disabling it on a host cuts off live sessions there.
[herd_host]
plankton.local
sandy.local

# sandy only, deliberately, and not a group that flips at cutover.
# plankton's Asterisk 16 is a hand-built bullseye-era install that predates any
# IaC; the role below provisions Asterisk 22 from Sangoma. Naming plankton here
# would point a major-version upgrade at a live PBX. It stays hand-managed until
# it is decommissioned.
[asterisk_host]
sandy.local

# sandy only, for the same reason. plankton's compose stack is running but has
# never been reconciled against the committed file since the HA version was
# pinned, so applying the role there would recreate live containers.
[docker_host]
sandy.local

[doma:vars]
ansible_python_interpreter=/usr/bin/python3
