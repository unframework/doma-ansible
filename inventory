[doma]
sandy.local    ansible_user=mmatants ansible_connection=local

# Hosts carrying the OpenClaw gateway (+ companions).
[openclaw_host]
sandy.local

# Host running the workspace web Mini App. Must be the live gateway host, which
# holds ~/.openclaw/timeline and ~/.openclaw/openclaw.json.
[webapp_host]
sandy.local

# Hosts running the herd agent session server (tailnet-only via Tailscale Serve).
# herd is how agent sessions reach the box — disabling it on a host cuts off
# live sessions there.
[herd_host]
sandy.local

# Host running the containerised Asterisk PBX.
[asterisk_host]
sandy.local

# Host running the Home Assistant + Music Assistant compose stack.
[docker_host]
sandy.local

# TFTP server for the Mitel desk phone's firmware. Must be the PBX host; the
# phone is pointed at its address (DHCP option 66 or the handset's own config).
[tftp_host]
sandy.local

# Hosts with a managed host firewall.
[firewall_host]
sandy.local

# Host running the drone-server audio engine (the box with the speakers).
[drone_host]
sandy.local

# Hosts whose avahi publishes only on the LAN interface, so <host>.local does
# not resolve to a docker bridge address.
[avahi_host]
sandy.local

[doma:vars]
ansible_python_interpreter=/usr/bin/python3

# Host serving *.dev.unframework.net to the tailnet (Caddy + portless). Must be
# the live gateway host: its Caddy takes over tailnet :443 and fronts the gateway.
[dev_proxy_host]
sandy.local
